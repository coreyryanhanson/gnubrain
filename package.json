{
	"name": "gnubrain",
	"version": "0.0.3",
	"description": "Open-source knowledge base for the pi coding agent, built on SiYuan. Register multiple KBs, keep the active set in session state, and let your agent read, search, query, and write with confirmation.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"siyuan",
		"knowledge-base"
	],
	"author": "Corey Ryan Hanson",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/coreyryanhanson/gnubrain.git"
	},
	"files": ["*.ts", "!vitest.config.ts"],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm test && npx tsc --noEmit && node scripts/check-pack.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"lint": "oxlint --deny-warnings",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"prepare": "husky"
	},
	"peerDependencies": {
		"typebox": "*"
	},
	"dependencies": {
		"node-sql-parser": "5.4.0",
		"pi-tool-masking": "2.1.0",
		"siyuan-kb-primitives": "file:../siyuan-kb-primitives"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@types/node": "^22.0.0",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"lint-staged": {
		"*.ts": [
			"oxfmt",
			"oxlint --fix --deny-warnings"
		]
	}
}
